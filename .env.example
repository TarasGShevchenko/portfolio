# Copy to .env.local for local development: cp .env.example .env.local
# On Vercel the same keys are set per environment (Production = master, Preview/staging = staging).

# Which deployment this is: local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Canonical origin of this deployment, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only (never NEXT_PUBLIC_): free Groq API key (console.groq.com) for the
# hero chat. Without it, or when the free daily quota runs out, the chat answers from
# prepared replies in lib/profile.ts.
GROQ_API_KEY=
